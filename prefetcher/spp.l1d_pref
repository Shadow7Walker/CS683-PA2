void CACHE::l1d_prefetcher_final_stats()
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << " CPU " << cpu << " SPP Final Statistics:" << std::endl;
    std::cout << "  Total Prefetches Issued:  " << total_issued_count << std::endl;
    std::cout << "  Total Useful Prefetches: " << total_useful_count << std::endl;
    if (total_issued_count > 0) {
        double acc = (double)total_useful_count / (double)total_issued_count * 100.0;
        std::cout << "  Final Prefetch Accuracy:  " << std::fixed << std::setprecision(2) << acc << "%" << std::endl;
    }
    std::cout << "  Final Active Degree:      " << current_degree << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
}